{
  "name": "@daracl/dialog",
  "version": "0.0.8",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "description": "Daracl dialog Message",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://www.moaview.com"
  },
  "license": "MIT",
  "keywords": [
    "daracl-dialog",
    "@daracl/dialog",
    "dialog",
    "darainfo",
    "message",
    "confirm",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/daracl/ui-dialog",
  "bugs": {
    "url": "https://github.com/daracl/ui-dialog/issues",
    "email": "darainfosys@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-dialog.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/*": "./dist/*",
    "./style/*": "./style/*",
    "./dist/": "./dist/",
    "./style/": "./style/",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "style"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@daracl/core": "^0.0.15",
    "@daracl/ui-style": "^0.0.8"
  },
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@babel/core": "^7.25.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-arrow-functions": "^7.25.7",
    "@babel/plugin-transform-block-scoping": "^7.25.7",
    "@babel/plugin-transform-strict-mode": "^7.25.7",
    "@babel/preset-env": "^7.25.7",
    "@types/jest": "^29.5.1",
    "@types/node": "^20.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "core-js": "^3.38.1",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "sass": "^1.107.0",
    "typescript": "5.6.3",
    "vite": "~7.3.7"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "npm run build:escjs && npm run build:umd && npm run mergenclean",
    "build:escjs": "vite build --config vite.config.mjs --mode production && vite build --config vite.config.mjs --mode development",
    "build:umd": "vite build --config vite.config.umd.mjs --mode production && vite build --config vite.config.umd.mjs --mode development",
    "mergenclean": "npm run copy-unmin && npm run clean:unmin && npm run build:tsc && npm run copy-legacy",
    "build:tsc": "tsc --emitDeclarationOnly",
    "copy-unmin": "node scripts/build-files.mjs unmin",
    "clean:unmin": "node scripts/build-files.mjs clean-unmin",
    "copy-legacy": "node scripts/build-files.mjs legacy",
    "dts:gen": "npm run build:tsc",
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src test scripts vite.common.mjs vite.config.mjs vite.config.umd.mjs",
    "audit:security": "npm audit --omit=dev",
    "audit:security:all": "npm audit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
